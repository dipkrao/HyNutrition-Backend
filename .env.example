# Server
NODE_ENV=production
PORT=5000

# MongoDB
MONGO_URI=mongodb://localhost:27017/hy_nutrition

# JWT
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRE=30d
JWT_COOKIE_EXPIRE=30

# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_EMAIL=noreply@hynutrition.in
SMTP_PASSWORD=your_app_password
FROM_NAME=HY Nutrition
FROM_EMAIL=noreply@hynutrition.in

# Razorpay
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# Stripe
STRIPE_SECRET_KEY=your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret

# Frontend URLs
WEBSITE_URL=https://hynutrition.in
ADMIN_URL=https://admin.hynutrition.in
